{
  "id": "10.0475",
  "info": [
    {
      "name": "DAtuviSezaH",
      "value": "10.0501 prAtipadikAt DAtvarTe bahulamizWavacca iti gaRasUtreRa atra 'suKa' iti prAtipadikameva svArTe kriyAM dyotayitum DAtusaMjYAM gfhRAti . ataSca atra DAtvarTaH api 'tatkriyAyAm' iti dIyate ."
    },
    {
      "name": "anubanDaviSezaH",
      "value": ""
    },
    {
      "name": "OpadeSikasvarUpam",
      "value": "suKa"
    },
    {
      "name": "arTaH",
      "value": "tatkriyAyAm"
    },
    {
      "name": "English Meaning",
      "value": "to make happy, to be happy"
    },
    {
      "name": "hindI arTa",
      "value": "suKI karanA, AnaMdAnuBava karanA"
    },
    {
      "name": "DAturUpanandinIwippaRI",
      "value": "“ prAtipadikAt DAtvarTe bahulamizWavacca ' (ga.sU. curAdO) ityasya vivaraRarUpoyaM DAtuH . suKaduHKaSabdayoH ' tat karoti, tadAcazwe, tenAkrAmati ' (ga.sU.curAdO) ityetezu arTezu ' Ric ' Bavati . ' sanAdyantAH DAtavaH ' (3.1.32) iti DAtusaMjYA “ iti kfdantarUpamAlA . “ prAtipadikAt DAtvarTe …' ityeva sidDe anayoH pAWaH sopasargAt pratyayArTam ityeke . suKaduHKAByAM tatkriyAyAmeva Ric syAt , na tu Acazwe ityasminnarTe ityetadarTaH pAWaH ityanye “ iti tattvaboDinI . atra tatkriyA = suKanam . suKAnukUlaH - vyApAraH . ' tatkriyA = tadanuBavaH ' iti DAtukAvyavyAKyAne .(3.62)"
    },
